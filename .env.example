# ==============================================================================
# FinZvit Data Worker & Pipeline Configuration (.env.local)
# ==============================================================================

# --- Supabase (База даних для швидкого пошуку) ---
# Отримайте в Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Секретний ключ service_role (потрібен для пакетного запису компаній у воркері)
SUPABASE_SECRET_KEY=eyJhbGciOi...

# --- Cloudflare R2 (Сховище звітів) ---
# Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=finzvit-data

# --- Cloudflare CDN Cache Purge (Опційно) ---
# Потрібно для автоматичного скидання кешу після імпорту нових звітів
# CF_API_TOKEN=your_cloudflare_api_token
# CF_ZONE_ID=your_zone_id
