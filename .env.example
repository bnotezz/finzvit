# ==============================================================================
# FinZvit Consolidated Configuration Template (.env.example)
# ==============================================================================
# Скопіюйте цей файл у .env.local у корені проєкту:
#   cp .env.example .env.local
#
# Всі сервіси (фронтенд Astro, воркер Python, утиліти) читають цей єдиний файл.

# --- 1. ФРОНТЕНД (Astro SSG / Клієнтський пошук у браузері) ---
# Supabase URL для прямих пошукових запитів з браузера
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Сучасний Publishable Key (sb_publishable_... або sbp_...)
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Базовий шлях до сховища фінансових звітів (за замовчуванням '/data')
PUBLIC_R2_URL=/data
# Google Analytics 4 (опціонально)
PUBLIC_GA_ID=G-XXXXXXXXXX
# Google Search Console (опціонально для верифікації сайту через мета-тег)
# PUBLIC_GOOGLE_SITE_VERIFICATION=your_gsc_token_here

# --- 2. PYTHON DATA WORKER (Імпорт датасетів та батч-синхронізація) ---
# Supabase URL (якщо відрізняється від PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://your-project.supabase.co
# Секретний ключ для запису реєстру (sb_secret_... або sbs_...)
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Cloudflare R2 Credentials (для завантаження JSON звітів у бакет)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=finzvit-data

# --- 3. CLOUDFLARE CDN CACHE PURGE (Опційно) ---
# Потрібно для автоматичного скидання кешу після завантаження нових звітів
# CLOUDFLARE_ZONE_ID=your_zone_id
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
