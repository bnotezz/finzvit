{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finzvit",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/data/*"],
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "finzvit-data"
    }
  ]
}
