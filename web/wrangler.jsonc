{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finzvit",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "vars": {
    "CACHE_VERSION": "v3"
  },
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  },
  "triggers": {
    "crons": [
      "0 7 * * *"
    ]
  },
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/data/*",
      "/company/*",
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "finzvit-data"
    }
  ]
}