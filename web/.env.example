# ==============================================================================
# FinZvit Web Frontend Configuration
# ==============================================================================

# Supabase URL (з панелі Supabase Settings -> API)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Сучасний Publishable Key (sb_publishable_... або sbp_...)
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Застарілий параметр (підтримується для зворотної сумісності):
# PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key_here

# Шлях до звітів (у Cloudflare Pages з R2 binding за замовчуванням '/data')
PUBLIC_R2_URL=/data

# Google Analytics 4 (опціонально для збору статистики та звітів популярності)
PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console (опціонально для підтвердження права власності на сайт через мета-тег)
# PUBLIC_GOOGLE_SITE_VERIFICATION=your_gsc_token_here
