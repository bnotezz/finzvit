# Supabase Configuration (для швидкого повнотекстового та триграмного пошуку)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare R2 Storage (URL публічного доступу або кастомного домену)
# За замовчуванням використовується локальний fallback '/data'
PUBLIC_R2_URL=/data
