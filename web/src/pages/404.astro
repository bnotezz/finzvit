---
import Layout from '../layouts/Layout.astro';
import { SearchBar } from '../components/search/SearchBar';
import { AlertCircle, ArrowLeft, Building2 } from 'lucide-react';

const SUGGESTED_COMPANIES = [
  { name: 'ТзОВ "Кормотех"', edrpou: '32673400' },
  { name: 'ТОВ "Нова Пошта"', edrpou: '31316718' },
  { name: 'ПАТ "Укрзалізниця"', edrpou: '40075815' },
];
---

<Layout title="404 — Сторінку не знайдено | FinZvit">
  <div class="min-h-[65vh] flex flex-col items-center justify-center py-12 px-4 text-center max-w-2xl mx-auto space-y-8 animate-in fade-in duration-500">
    
    <!-- 404 Бейдж та Іконка -->
    <div class="relative">
      <div class="w-20 h-20 rounded-3xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-400 mx-auto shadow-2xl shadow-rose-500/10">
        <AlertCircle className="w-10 h-10" />
      </div>
      <div class="absolute -bottom-2 -right-2 px-2.5 py-0.5 rounded-full bg-zinc-900 border border-white/10 text-[10px] font-mono font-bold text-zinc-400">
        404
      </div>
    </div>

    <!-- Заголовок та опис -->
    <div class="space-y-3">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Сторінку не знайдено
      </h1>
      <p class="text-sm sm:text-base text-zinc-400 max-w-md mx-auto leading-relaxed">
        Запитувана адреса не існує, була переміщена або код ЄДРПОУ введено невірно.
      </p>
    </div>

    <!-- Пошуковий термінал прямо на сторінці 404 -->
    <div class="w-full max-w-lg mx-auto pt-2">
      <SearchBar client:load size="medium" autoFocus={false} />
    </div>

    <!-- Швидкі підказки або повернення -->
    <div class="space-y-4 pt-4 border-t border-white/5 w-full">
      <div class="text-xs font-mono text-zinc-500 uppercase tracking-wider">
        Популярні перевірені компанії:
      </div>
      <div class="flex flex-wrap items-center justify-center gap-2">
        {SUGGESTED_COMPANIES.map((c) => (
          <a
            href={`/company/${c.edrpou}`}
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-zinc-900/80 hover:bg-zinc-800 border border-white/10 hover:border-accent/40 text-xs text-zinc-300 hover:text-white transition-all font-mono"
          >
            <Building2 className="w-3.5 h-3.5 text-accent" />
            <span>{c.name} ({c.edrpou})</span>
          </a>
        ))}
      </div>

      <div class="pt-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-white/10 text-white text-xs font-medium transition-all"
        >
          <ArrowLeft className="w-4 h-4 text-zinc-400" />
          <span>Повернутися на головну</span>
        </a>
      </div>
    </div>

  </div>
</Layout>
