---
import Layout from '../layouts/Layout.astro';
import { SearchBar } from '../components/search/SearchBar';
import { FeaturedCompanies } from '../components/home/FeaturedCompanies';
import { 
  Building2, 
  TrendingUp, 
  FileSpreadsheet, 
  ShieldCheck, 
  ExternalLink, 
  Sparkles,
  ArrowRight,
  Layers,
  Database,
  BarChart3
} from 'lucide-react';
---

<Layout
  title="FinZvit — Відкрита фінансова звітність підприємств України"
  description="Офіційна фінансова звітність юридичних осіб України за даними ДПС та Держстату (data.gov.ua). Баланс (Ф1), звіт про фінрезультати (Ф2), рух коштів (Ф3), капітал (Ф4) та показники KPI понад 300,000+ компаній."
>
  <!-- Фоновий неоновий градієнт та сітка -->
  <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-gradient-to-b from-emerald-500/10 via-teal-500/5 to-transparent blur-[140px] rounded-full"></div>
    <div class="absolute top-1/3 -left-40 w-[500px] h-[500px] bg-indigo-500/5 blur-[120px] rounded-full"></div>
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff0a_1px,transparent_1px)] [background-size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
  </div>

  <div class="flex flex-col items-center justify-center pt-8 pb-20 max-w-5xl mx-auto space-y-12">
    
    <!-- Верхній преміальний бейдж -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-zinc-900/90 border border-white/10 shadow-2xl backdrop-blur-xl animate-in fade-in slide-in-from-top-4 duration-700">
      <span class="flex h-2 w-2 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span class="text-xs font-medium text-zinc-300">
        Офіційні відкриті дані Держстату України · Фінансова звітність
      </span>
      <span class="text-zinc-600">•</span>
      <a 
        href="https://data.gov.ua/dataset/7436ae83-dfc1-4836-9962-8af3e831c522" 
        target="_blank" 
        class="text-xs font-mono text-accent hover:underline flex items-center gap-1"
      >
        <span>data.gov.ua</span>
        <ExternalLink className="w-3 h-3" />
      </a>
    </div>

    <!-- Головний титульний блок -->
    <div class="text-center space-y-5 max-w-3xl">
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white leading-[1.08]">
        Фінансова звітність <br />
        <span class="bg-gradient-to-r from-emerald-400 via-teal-200 to-indigo-300 bg-clip-text text-transparent">
          в офіційних формах
        </span>
      </h1>
      <p className="text-base sm:text-lg text-zinc-400 max-w-2xl mx-auto font-normal leading-relaxed">
        Введіть код ЄДРПОУ будь-якої юридичної особи України та досліджуйте Баланс (Ф1), Фінрезультати (Ф2), Рух коштів (Ф3) та Власний капітал (Ф4) у точній відповідності до державних стандартів.
      </p>
    </div>

    <!-- Пошуковий термінал -->
    <div class="w-full pt-2">
      <SearchBar client:load autoFocus={true} size="large" />
    </div>

    <!-- Картки верифікованих підприємств для швидкого перегляду (випадкові 3 на клієнті) -->
    <FeaturedCompanies client:load />

    <!-- Трійка головних переваг системи -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6 w-full">
      <div class="p-6 rounded-3xl border border-white/5 bg-zinc-950/60 backdrop-blur-xl space-y-3 relative overflow-hidden group hover:border-accent/30 transition-colors">
        <div class="w-10 h-10 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-accent">
          <FileSpreadsheet className="w-5 h-5" />
        </div>
        <h3 class="font-bold text-white text-base">Офіційні форми Держстату</h3>
        <p class="text-xs text-zinc-400 leading-relaxed">
          Структура таблиць строго відповідає бланкам Ф1, Ф2, Ф3, Ф4 та формам малого бізнесу з кодами рядків, підсумками та контрактивними статтями.
        </p>
      </div>

      <div class="p-6 rounded-3xl border border-white/5 bg-zinc-950/60 backdrop-blur-xl space-y-3 relative overflow-hidden group hover:border-indigo-500/30 transition-colors">
        <div class="w-10 h-10 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400">
          <TrendingUp className="w-5 h-5" />
        </div>
        <h3 class="font-bold text-white text-base">Миттєва фінансова аналітика</h3>
        <p class="text-xs text-zinc-400 leading-relaxed">
          Автоматичний підрахунок виручки, чистого фінансового результату, активів і капіталу з відсотковою динамікою порівняно з минулим періодом.
        </p>
      </div>

      <div class="p-6 rounded-3xl border border-white/5 bg-zinc-950/60 backdrop-blur-xl space-y-3 relative overflow-hidden group hover:border-teal-500/30 transition-colors">
        <div class="w-10 h-10 rounded-2xl bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-400">
          <ShieldCheck className="w-5 h-5" />
        </div>
        <h3 class="font-bold text-white text-base">100% Верифіковані дані</h3>
        <p class="text-xs text-zinc-400 leading-relaxed">
          Пряма інтеграція з офіційним реєстром річної звітності порталу data.gov.ua (ДПС та Держстат). Жодних прихованих або спотворених цифр.
        </p>
      </div>
    </div>

  </div>
</Layout>
