---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogType?: 'website' | 'article' | 'business.business';
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'FinZvit — Відкрита фінансова звітність підприємств України',
  description = 'Офіційна фінансова звітність юридичних осіб України за даними ДПС та Держстату (data.gov.ua). Баланс (Ф1), звіт про фінрезультати (Ф2), рух коштів (Ф3), капітал (Ф4) та показники KPI.',
  keywords = 'фінансова звітність, баланс підприємства, форма 1, звіт про прибутки та збитки, форма 2, рух коштів, форма 3, ЄДРПОУ, відкриті дані, data.gov.ua, аналітика компаній України',
  ogType = 'website',
  ogImage = '/og-image.png',
  canonicalUrl,
  jsonLd,
} = Astro.props;

const siteUrl = 'https://finzvit.bnotezz.workers.dev';
const effectiveCanonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
const effectiveOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

const defaultJsonLd = jsonLd || {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  'name': 'FinZvit',
  'url': siteUrl,
  'description': description,
  'applicationCategory': 'BusinessApplication',
  'operatingSystem': 'All',
  'inLanguage': 'uk-UA',
  'offers': {
    '@type': 'Offer',
    'price': '0',
    'priceCurrency': 'UAH',
  },
};
---

<!doctype html>
<html lang="uk" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    
    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="FinZvit" />
    <link rel="canonical" href={effectiveCanonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#10B981" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="FinZvit" />
    <meta name="application-name" content="FinZvit" />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={effectiveCanonical} />
    <meta property="og:site_name" content="FinZvit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={effectiveOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="uk_UA" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={effectiveCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={effectiveOgImage} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(defaultJsonLd)} />

    <!-- Typography (Inter & Geist Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#07080B] text-zinc-100 min-h-screen flex flex-col font-sans selection:bg-accent/20 selection:text-accent relative overflow-x-hidden">
    <!-- Верхній навігаційний бар -->
    <header class="border-b border-white/5 bg-[#07080B]/80 backdrop-blur-xl sticky top-0 z-50 no-print">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <img
            src="/favicon.svg"
            alt="FinZvit Logo"
            class="w-9 h-9 rounded-xl shadow-lg shadow-emerald-500/15 group-hover:scale-105 transition-all"
            width="36"
            height="36"
          />
          <div class="flex flex-col">
            <span class="font-extrabold text-lg tracking-tight text-white flex items-center gap-2">
              <span>Fin<span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-400">Zvit</span></span>
              <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                ВІДКРИТІ ДАНІ
              </span>
            </span>
          </div>
        </a>

        <div class="flex items-center gap-3 text-xs">
          <a
            href="https://data.gov.ua/dataset/7436ae83-dfc1-4836-9962-8af3e831c522"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-zinc-400 hover:text-white transition-colors bg-zinc-900/80 border border-white/10 px-3.5 py-1.5 rounded-xl hover:border-white/20"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Джерело: data.gov.ua</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Основний контент -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <!-- Футер -->
    <footer class="border-t border-white/5 bg-[#07080B] py-8 text-center text-xs text-zinc-500 no-print mt-auto">
      <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="text-zinc-400 font-semibold">FinZvit</span>
          <span>— відкрита фінансова звітність юридичних осіб України (НП(С)БО та МСФЗ)</span>
        </div>
        <div class="flex items-center gap-4 text-zinc-400 font-mono text-[11px]">
          <span>Звітні періоди: 2024–2025</span>
          <span>•</span>
          <a href="https://data.gov.ua" target="_blank" class="hover:text-accent transition-colors">data.gov.ua</a>
        </div>
      </div>
    </footer>
  </body>
</html>
