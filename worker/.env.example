# ==============================================================================
# FinZvit Python Data Worker Configuration
# ==============================================================================

# Supabase Credentials (для батч-синхронізації реєстру компаній)
SUPABASE_URL=https://your-project.supabase.co

# Сучасний Secret Key (sb_secret_... або sbs_...)
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Застарілий параметр (підтримується для зворотної сумісності):
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key_here

# Cloudflare R2 Credentials (для завантаження JSON звітів у бакет)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=finzvit-data
